{
  "name": "@lkw-ai/sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for the LKW low-code workflow platform. Type-safe wrapper over the LKW REST API with retry, auth, and typed payloads.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "gen:types": "tsx scripts/gen-types.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "openapi-typescript": "^7.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkw-ai/lkw-sdk.git"
  },
  "homepage": "https://github.com/lkw-ai/lkw-sdk",
  "keywords": ["lkw", "sdk", "workflow", "automation", "typescript"]
}
